+--! Adjusts settings for touch screen devices (iOS). The C++ side has already
+--! worked out the resolution to use and where any bundled game data is.
+function App:applyTouchConfig()
+  local config = self.config
+  local width = tonumber(os.getenv("CORSIXTH_TOUCH_WIDTH"))
+  local height = tonumber(os.getenv("CORSIXTH_TOUCH_HEIGHT"))
+  if width and height then
+    config.width = width
+    config.height = height
+  end
+  config.fullscreen = true
+  config.ui_scale = 1
+  -- The map is panned with two fingers, and after a tap the pointer often
+  -- rests at the edge of the screen, so edge scrolling only gets in the way.
+  config.prevent_edge_scrolling = true
+  config.capture_mouse = false
+  config.right_mouse_scrolling = false
+  -- The app's folder moves whenever it is reinstalled, so always use the copy
+  -- of the game data inside the app that is running now.
+  local data = os.getenv("CORSIXTH_BUNDLED_DATA")
+  if data then
+    config.theme_hospital_install = data
+  end
+  -- Saves and logs live in iCloud Drive when it's available (the C++ side
+  -- checks); otherwise nil puts them in the default place next to config.txt.
+  config.savegames = os.getenv("CORSIXTH_SAVE_DIR")
+  config.logs = os.getenv("CORSIXTH_LOG_DIR")
+  if config.touch_controls ~= "direct" then
+    config.touch_controls = "trackpad"
+  end
+  SDL.wm.setTouchControls(config.touch_controls)
+  local music = os.getenv("CORSIXTH_BUNDLED_MUSIC")
+  if music and (not config.audio_music or
+      lfs.attributes(config.audio_music, "mode") ~= "directory") then
+    config.audio_music = music
+  end
+end
+
+--! Touch devices (iOS): the app is going into the background, where it may be
+--! closed without warning, so save the game to carry on from next time.
+function App:onAppBackground()
+  if not self.touch_ui or not self.world or not self.savegame_dir then
+    return
+  end
+  -- iOS can report the same move to the background twice; one save will do.
+  local now = SDL.getTicks()
+  if self.last_resume_save and now - self.last_resume_save < 2000 then
+    return
+  end
+  self.last_resume_save = now
+  local ok, err = pcall(self.save, self, self.savegame_dir .. "Resume.sav")
+  print(ok and "Saved the game to Resume.sav" or
+      ("Could not save the game for resuming: " .. tostring(err)))
+end
+
+--! Shows or hides the on-screen keyboard on touch devices.
+--!param active (boolean) Whether a text box now wants typing.
+--!param x, y, w, h (integers, optional) Where the text box is on screen.
+function App:setTextInputActive(active, x, y, w, h)
+  if not self.touch_ui then
+    return
+  end
+  if active and x and y and w and h then
+    SDL.wm.setTextInputActive(true, math.floor(x), math.floor(y),
+        math.floor(w), math.floor(h))
+  else
+    SDL.wm.setTextInputActive(active and true or false)
+  end
+end
+
 function App:saveConfig()
   local conf_path = self.command_line["config-file"] or "config.txt"
   require('config_finder').save_config(conf_path, self.config)
